{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noEmit": true,
        "exactOptionalPropertyTypes": true
    },
    "include": ["src/**/*.ts", "src/**/*.cts", "test/**/*.ts"]
}
