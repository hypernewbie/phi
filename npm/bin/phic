#!/usr/bin/env node
const { spawn } = require('node:child_process');
const path = require('node:path');

if (process.platform === 'win32') {
    console.error(
        'phic supports macOS and Linux. Use the Phi browser or desktop client on Windows.',
    );
    process.exit(1);
} else {
    const child = spawn(
        path.join(__dirname, 'phic-native'),
        process.argv.slice(2),
        {
            stdio: 'inherit',
        },
    );
    for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
        process.on(signal, () => child.kill(signal));
    }
    child.on('error', (err) => {
        console.error(
            `phic could not start: ${err.message}. Reinstall @hypernewbie/phi-code with install scripts enabled.`,
        );
        process.exitCode = 1;
    });
    child.on('close', (code) => process.exit(code ?? 1));
}
