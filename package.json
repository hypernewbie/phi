{
  "name": "phi-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only tooling for phi frontend JS tests. NOT the published package (see npm/package.json).",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:web": "tsc -p tsconfig.build.json && pnpm format",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "vite",
    "build:desktop": "pnpm --dir desktop/electron run build",
    "dev:desktop": "pnpm --dir desktop/electron run build && pnpm --dir desktop/electron run dev",
    "watch:web": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "lint:web": "stylelint web/style.css && biome lint web/index.html web/md.html web/config.html web/style.css",
    "lint:code": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check:code": "biome ci .",
    "check": "pnpm typecheck && pnpm lint:web && pnpm check:code && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@noble/hashes": "^2.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dompurify": "^3.4.12",
    "jsdom": "^30.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
