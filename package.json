{
  "name": "phi-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only tooling for phi frontend JS tests. NOT the published package (see npm/package.json).",
  "type": "module",
  "scripts": {
    "build:web": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "vite",
    "watch:web": "tsc -p tsconfig.build.json -w --preserveWatchOutput"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "chart.js": "^4.5.1",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
