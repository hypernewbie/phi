{
  "name": "phi-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only tooling for phi frontend JS tests. NOT the published package (see npm/package.json).",
  "type": "module",
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:web": "tsc -p tsconfig.build.json && node scripts/websocket.mjs build",
    "gen:websocket": "node scripts/websocket.mjs generate",
    "check:websocket-generated": "node scripts/websocket.mjs check",
    "gen:pi-phi": "node scripts/pi-phi-generate.mjs",
    "build:pi-phi": "node scripts/pi-phi-build.mjs",
    "check:pi-phi-generated": "node scripts/pi-phi-check-generated.mjs",
    "test:pi-phi:integration": "node scripts/pi-phi-integration.mjs",
    "test:pi-phi:hosts": "node scripts/pi-phi-hosts.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.e2e.json && tsc -p packages/phi-core/tsconfig.json && tsc -p packages/phi-core/tsconfig.test.json && tsc -p packages/web-react/tsconfig.json && tsc -p packages/web-react/tsconfig.test.json && tsc -p packages/web-react/tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "pnpm build:web && pnpm --dir desktop/electron build && playwright test -c playwright.desktop.config.ts",
    "sync:vendors": "node scripts/sync-frontend-vendors.mjs",
    "check:vendors": "node scripts/sync-frontend-vendors.mjs --check",
    "build:desktop": "pnpm --filter phi-desktop-electron run build",
    "dev:desktop": "pnpm --filter phi-desktop-electron run build && pnpm --filter phi-desktop-electron run dev",
    "watch:web": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "lint:web": "stylelint web/style.css",
    "lint:code": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check:code": "biome ci .",
    "check": "pnpm typecheck && pnpm --filter @phi/pi-phi typecheck && pnpm lint:web && pnpm check:code && pnpm check:vendors && pnpm --filter @phi/pi-phi test && pnpm test"
  },
  "devDependencies": {
    "@alenaksu/json-viewer": "catalog:",
    "@biomejs/biome": "catalog:",
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protobuf": "2.14.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@highlightjs/cdn-assets": "catalog:",
    "@noble/hashes": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-search": "catalog:",
    "@xterm/addon-serialize": "catalog:",
    "@xterm/addon-unicode11": "catalog:",
    "@xterm/addon-webgl": "catalog:",
    "@xterm/headless": "catalog:",
    "@xterm/xterm": "catalog:",
    "chart.js": "catalog:",
    "diff": "catalog:",
    "diff2html": "catalog:",
    "dompurify": "catalog:",
    "esbuild": "0.28.2",
    "jsdom": "catalog:",
    "marked": "catalog:",
    "pdfjs-dist": "catalog:",
    "plyr": "catalog:",
    "sortablejs": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "ts-proto": "2.18.0",
    "typescript": "catalog:",
    "viewerjs": "catalog:",
    "vitest": "catalog:"
  }
}
