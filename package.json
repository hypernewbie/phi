{
  "name": "phi-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only tooling for phi frontend JS tests. NOT the published package (see npm/package.json).",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:web": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "vite",
    "watch:web": "tsc -p tsconfig.build.json -w --preserveWatchOutput"
  },
  "devDependencies": {
    "@noble/hashes": "^2.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "dompurify": "^3.4.12",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
