<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phi dark-theme tokens, verbatim from web/style.css via
         desktop/electron/src/rail.css (:root mirror). Same names as the
         web CSS vars, values byte-identical. Do not invent colors here.
         bg = bg-base, panel = bg-panel. -->
    <color name="bg">#08080A</color>          <!-- bg-base -->
    <color name="panel">#0D0D10</color>       <!-- bg-panel -->
    <color name="bg_elevated">#141418</color>
    <color name="bg_border">#1F1F26</color>
    <color name="text_primary">#E4E3E9</color>
    <color name="text_muted">#78768A</color>

    <!-- The obsidian field behind the rail (web body background). -->
    <color name="field_gradient_top">#16161C</color>

    <!-- theme.ts ACCENT_COLORS.purple.accent — the web client's default
         accent ('purple'); the shell's resting accent until a server
         reports its own. -->
    <color name="accent_default">#7C6AF7</color>

    <!-- picker.html (the add-server reference) carries its own input
         scale; copied verbatim, including its indigo Add button. -->
    <color name="picker_field">#141416</color>
    <color name="picker_border">#333333</color>
    <color name="picker_accent">#4F46E5</color>
    <color name="picker_error">#F87171</color>
    <color name="picker_btn_bg">#1C1C1F</color>
</resources>
