<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Content stage: everything the user sees when the drawer is shut.
         Must NOT be a direct child with drawer-edge gravity — DrawerLayout
         treats any start/end-gravity child as a drawer, and two drawers on
         one edge crash onMeasure (IllegalStateException). -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Edge affordance: glass chevron riding the drawer edge. -->
        <FrameLayout
            android:id="@+id/edgeHandle"
            android:layout_width="28dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/edgeChevron"
                android:layout_width="28dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="❮"
                android:textSize="18sp"
                android:textColor="@color/text_muted"
                android:background="@drawable/edge_handle_bg" />
        </FrameLayout>
    </FrameLayout>

    <!-- Native server drawer: obsidian glass, Greek badges, zoom. -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/panel"
        android:paddingTop="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/ic_launcher" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="PHI"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="8dp"
            android:background="#28FFFFFF" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/serverList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:text="VIEW"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">
            <Button
                android:id="@+id/zoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="100%"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
            <Button
                android:id="@+id/zoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/addServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="+ Add server" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
