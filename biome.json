{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            ".stylelintrc.js",
            "vite.config.js",
            "vitest.config.js",
            "npm/scripts/**/*.js",
            "web-src/**/*.ts",
            "test-js/**/*.js",
            "e2e/**/*.ts",
            "playwright.config.ts",
            "desktop/electron/src/**/*.ts",
            "desktop/electron/test/**/*.ts",
            "desktop/electron/scripts/**/*.mjs",
            "desktop/electron/vitest.config.ts",
            "desktop/pet/src/**/*.ts",
            "desktop/pet/test/**/*.ts",
            "desktop/pet/scripts/**/*.mjs",
            "desktop/pet/vitest.config.ts",
            "!web",
            "!desktop/pet/**/*.js.map"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "assist": {
        "enabled": false
    },
    "overrides": [
        {
            "includes": ["desktop/electron/test/injected.test.ts"],
            "formatter": {
                "indentStyle": "space",
                "indentWidth": 2
            },
            "linter": {
                "rules": {
                    "security": {
                        "noGlobalEval": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "npm/scripts/install.js",
                "desktop/electron/**/*.ts",
                "desktop/electron/**/*.mjs",
                "desktop/electron/vitest.config.ts",
                "desktop/pet/**/*.ts",
                "desktop/pet/**/*.mjs"
            ],
            "formatter": {
                "indentStyle": "space",
                "indentWidth": 2
            }
        },
        {
            "includes": ["desktop/pet/**/*.ts", "desktop/pet/**/*.mjs"],
            "formatter": {
                "enabled": true,
                "indentStyle": "space",
                "indentWidth": 2
            },
            "javascript": {
                "formatter": {
                    "quoteStyle": "double"
                }
            }
        }
    ]
}
