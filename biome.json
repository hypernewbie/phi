{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            ".stylelintrc.js",
            "vite.config.js",
            "vitest.config.js",
            "npm/scripts/**/*.js",
            "web-src/**/*.ts",
            "test-js/**/*.js",
            "web/**/*.js",
            "web/**/*.html",
            "web/**/*.css",
            "desktop/electron/src/**/*.ts",
            "desktop/electron/test/**/*.ts",
            "desktop/electron/scripts/**/*.mjs",
            "desktop/electron/vitest.config.ts",
            "desktop/pet/src/**/*.ts",
            "desktop/pet/test/**/*.ts",
            "desktop/pet/scripts/**/*.mjs",
            "desktop/pet/vitest.config.ts",
            "!web/vendor",
            "!web/attachments.js",
            "!web/desktop.js",
            "!web/diff.js",
            "!web/filetree.js",
            "!web/kanban-features.js",
            "!web/kanban.js",
            "!web/markdown.js",
            "!web/md-render.js",
            "!web/md-view.js",
            "!web/sessions.js",
            "!web/sync.js",
            "!web/util.js",
            "!web/ws.js",
            "!desktop/pet/**/*.js.map"
        ]
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true,
            "selfCloseVoidElements": "never",
            "whitespaceSensitivity": "css"
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "noImportantStyles": "off"
            },
            "style": {
                "noDescendingSpecificity": "off"
            }
        }
    },
    "assist": {
        "enabled": false
    },
    "overrides": [
        {
            "includes": ["web/*.html"],
            "linter": {
                "rules": {
                    "a11y": {
                        "useButtonType": "off",
                        "noSvgWithoutTitle": "warn"
                    }
                }
            }
        },
        {
            "includes": ["desktop/electron/test/injected.test.ts"],
            "formatter": {
                "indentStyle": "space",
                "indentWidth": 2
            },
            "linter": {
                "rules": {
                    "security": {
                        "noGlobalEval": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "npm/scripts/install.js",
                "desktop/electron/**/*.ts",
                "desktop/electron/**/*.mjs",
                "desktop/electron/vitest.config.ts",
                "desktop/pet/**/*.ts",
                "desktop/pet/**/*.mjs"
            ],
            "formatter": {
                "indentStyle": "space",
                "indentWidth": 2
            }
        },
        {
            "includes": ["desktop/pet/**/*.ts", "desktop/pet/**/*.mjs"],
            "formatter": {
                "enabled": true,
                "indentStyle": "space",
                "indentWidth": 2
            },
            "javascript": {
                "formatter": {
                    "quoteStyle": "double"
                }
            }
        }
    ]
}
