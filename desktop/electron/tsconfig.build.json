{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false,
    "removeComments": false
  },
  "include": ["src"],
  // The preload is emitted as CommonJS by tsconfig.preload.json (sandboxed
  // preload scripts cannot be ESM); excluding it here keeps the ESM build
  // from emitting an ESM dist/preload.js that would be overwritten.
  "exclude": ["src/preload.ts"]
}
