{
  "appId": "dev.phi.desktop",
  "productName": "phi-client",
  "artifactName": "phi-client-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "out"
  },
  "files": ["dist/**", "src/**", "web/**", "embedded/**", "assets/**", "package.json"],
  "asarUnpack": ["assets/**"],
  "win": {
    "icon": "assets/icon.png"
  },
  "mac": {
    "icon": "assets/icon.icns",
    "category": "public.app-category.developer-tools",
    "extendInfo": {
      "CFBundleDisplayName": "phi-client",
      "LSMultipleInstancesProhibited": true,
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "dev.phi.desktop",
          "CFBundleURLSchemes": ["phi"]
        }
      ]
    }
  }
}
